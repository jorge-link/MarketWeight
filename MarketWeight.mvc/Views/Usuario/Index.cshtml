@model IEnumerable<MarketWeight.Core.UsuarioDTO>
@inject IHttpContextAccessor HttpContextAccessor

@{
    int? idUsuarioSesion = HttpContextAccessor.HttpContext.Session.GetInt32("IdUsuario");
}

<h2>Listado de Usuarios</h2>

<div class="table-container">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Email</th>
                <th>Saldo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                var esUsuarioLogueado = usuario.IdUsuario == (uint?)idUsuarioSesion;
                <tr class="@(esUsuarioLogueado ? "usuario-logueado" : "")">
                    <td>@usuario.IdUsuario</td>
                    <td>
                        @usuario.Nombre
                        @if(esUsuarioLogueado)
                        {
                            <span class="tu-label">(Tú)</span>
                        }
                    </td>
                    <td>@usuario.Apellido</td>
                    <td>@usuario.Email</td>
                    <td>@usuario.Saldo.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #333;
    }

    h2 {
        text-align: center;
        margin-top: 80px;
        color: #fff;
    }

    .table-container {
        max-width: 900px;
        margin: 20px auto;
        background: rgba(255, 255, 255, 0.95);
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 12px 15px;
        text-align: left;
    }

    th {
        background: #667eea;
        color: #fff;
        font-weight: bold;
        border-radius: 5px;
    }

    tr:nth-child(even) {
        background: #f2f2f2;
    }

    tr.usuario-logueado {
        background-color: #d4edda !important; /* Verde claro */
        font-weight: bold;
    }

    .tu-label {
        font-size: 0.9rem;
        font-weight: normal;
        color: #2c662d;
        margin-left: 5px;
    }

    .table-striped tbody tr:hover {
        background-color: rgba(102, 126, 234, 0.2);
        transition: 0.3s;
    }
</style>
