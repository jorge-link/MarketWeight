@model MarketWeight.mvc.ViewModels.VMComprarMoneda

@{
    ViewData["Title"] = "Comprar Moneda";
}

<div class="home-container">
    <div class="home-card">
        <h1>Comprar <span class="brand">Moneda</span></h1>
        <p>Selecciona la moneda y la cantidad que deseas comprar</p>

        <form asp-action="ComprarMonedaPost" asp-controller="Compra" method="post">

            <div class="form-group mt-3">
                <label for="IdMoneda">Selecciona una moneda</label>
                <select asp-for="IdMoneda" class="form-control" required id="monedaSelect">
                    <option value="">-- Elige una moneda --</option>
                    @foreach (var m in Model.Monedas)
                    {
                        <option value="@m.IdMoneda" data-img="@m.Url">@m.Nombre</option>
                    }
                </select>

            </div>

            <!-- Aquí se mostrará la imagen -->
            <div class="form-group mt-3" id="monedaImagenContainer" style="display:none;">
                <img id="monedaImagen" src="" alt="Imagen de la moneda" style="max-height:100px;" />
            </div>

            <div class="form-group mt-3">
                <label for="Cantidad">Cantidad</label>
                <input type="number" name="Cantidad" class="form-control" step="0.00000001" min="0.00000001" required placeholder="Cantidad a comprar" />
            </div>

            <button type="submit" class="btn btn-primary mt-3">Comprar</button>
        </form>

        @if(ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger mt-3">
                <ul>
                    @foreach(var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

<script>
    document.getElementById("monedaSelect").addEventListener("change", function() {
        const selected = this.options[this.selectedIndex];
        const imgUrl = selected.getAttribute("data-img");
        const imgContainer = document.getElementById("monedaImagenContainer");
        const imgTag = document.getElementById("monedaImagen");

        if (imgUrl) {
            imgTag.src = imgUrl;
            imgContainer.style.display = "block";
        } else {
            imgContainer.style.display = "none";
        }
    });
</script>
