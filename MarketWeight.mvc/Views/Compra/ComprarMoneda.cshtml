@model MarketWeight.mvc.ViewModels.VMComprarMoneda

@{
    ViewData["Title"] = "Comprar Moneda";
}

<div class="home-container">
    <div class="home-card">
        <h1 class="mb-3">Comprar <span class="brand">Moneda</span></h1>
        <p class="text-muted">Selecciona la moneda y la cantidad que deseas comprar</p>

        <form asp-action="ComprarMonedaPost" asp-controller="Compra" method="post" class="mt-4">

            <!-- Selección de moneda -->
            <div class="mb-3">
                <label for="IdMoneda" class="form-label fw-bold">Selecciona una moneda</label>
                <select asp-for="IdMoneda" class="form-select rounded-pill shadow-sm" required id="monedaSelect">
                    <option value="">-- Elige una moneda --</option>
                    @foreach (var m in Model.Monedas)
                    {
                        <option value="@m.IdMoneda" data-img="@m.Url">@m.Nombre</option>
                    }
                </select>
            </div>

            <!-- Imagen de la moneda -->
            <div class="mb-3 text-center" id="monedaImagenContainer" style="display:none;">
                <img id="monedaImagen" src="" alt="Imagen de la moneda" class="img-fluid rounded shadow-sm" style="max-height:120px;" />
            </div>

            <!-- Cantidad -->
            <div class="mb-3">
                <label for="Cantidad" class="form-label fw-bold">Cantidad</label>
                <input type="number" name="Cantidad" class="form-control rounded-pill shadow-sm"
                    step="0.00000001" min="0.00000001" required placeholder="Cantidad a comprar" />
            </div>

            <!-- Botón -->
            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-primary rounded-pill fw-bold shadow-sm">
                    Comprar
                </button>
            </div>
        </form>

        <!-- Errores -->
        @if(ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger mt-4">
                <ul class="mb-0">
                    @foreach(var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

<script>
    document.getElementById("monedaSelect").addEventListener("change", function () {
        const selected = this.options[this.selectedIndex];
        const imgUrl = selected.getAttribute("data-img");
        const imgContainer = document.getElementById("monedaImagenContainer");
        const imgTag = document.getElementById("monedaImagen");

        if (imgUrl) {
            imgTag.src = imgUrl;
            imgContainer.style.display = "block";
        } else {
            imgContainer.style.display = "none";
        }
    });
</script>
