@inject IHttpContextAccessor HttpContextAccessor
@{
    int? idUsuario = HttpContextAccessor.HttpContext.Session.GetInt32("IdUsuario");
    decimal saldo = ViewBag.Saldo != null ? (decimal)ViewBag.Saldo : 0;

    // Obtener el nombre del controller y action actuales
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarketWeight</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea, #764ba2);
            min-height: 100vh;
            padding-top: 70px; /* altura barra */
        }

        .home-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            padding: 10px 20px;
            background: rgba(255, 255, 255, 0.95);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            position: fixed;
            width: 100%;
            top: 0;
            left: 0;
            z-index: 100;
        }

        .home-bar-left .brand {
            font-weight: bold;
            color: #764ba2;
            font-size: 1.5rem;
        }

        .home-bar-right {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
        }

        .home-bar-right .btn {
            margin: 5px 5px 0 5px;
            padding: 8px 20px;
            border-radius: 50px;
            background: #667eea;
            color: #fff;
            text-decoration: none;
            font-weight: bold;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .home-bar-right .btn:hover {
            background: #5a67d8;
        }

        /* Botón activo/seleccionado */
        .home-bar-right .btn.active {
            background: #e0e0e0; /* gris claro */
            color: #333; /* texto oscuro */
            font-weight: bold;
        }

        .home-bar-right .btn.secondary {
            background: #764ba2;
        }

        .home-bar-right .btn.secondary:hover {
            background: #5a3e9e;
        }

        .saldo {
            font-weight: bold;
            margin: 5px 10px 0 0;
            color: #333;
        }

        .inline-form {
            display: inline-block;
            margin: 0;
        }

        /* Media queries para responsividad */
        @@media (max-width: 768px) {
            .home-bar-left, .home-bar-right {
                width: 100%;
                justify-content: center;
                margin-bottom: 10px;
            }
        }

        @@media (max-width: 480px) {
            .home-bar-right .btn {
                padding: 6px 15px;
                font-size: 0.8rem;
            }
            .saldo {
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>
    <div class="home-bar">
        <div class="home-bar-left">
            <span class="brand">MarketWeight</span>
        </div>
        <div class="home-bar-right">
            @if(idUsuario != null)
            {
                <span class="saldo">Saldo: $@saldo</span>  <!-- saldo primero -->
                <a href="/Home/Index" class="btn @(currentController=="Home"?"active":"")">Home</a>
                <a href="/Compra/ComprarMoneda" class="btn @(currentController=="Compra"?"active":"")">Comprar Moneda</a>
                <a href="/Usuario/Index" class="btn @(currentController=="Usuario"?"active":"")">Ver Usuarios</a>
                <form method="post" action="/Login/Logout" class="inline-form">
                    <button type="submit" class="btn secondary">Cerrar Sesión</button>
                </form>
            }
            else
            {
                <a href="/Login/Index" class="btn @(currentController=="Login"?"active":"")">Iniciar Sesión</a>
                <a href="/Login/Registro" class="btn @(currentController=="Login" && currentAction=="Registro"?"active":"")">Registrarse</a>
            }
        </div>

    </div>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
