@{
    ViewData["Title"] = "Login";
}

<div class="login-container">
    <form method="post" class="login-form">
        <h2>Iniciar Sesión</h2>

        <input type="email" name="email" placeholder="Correo" required />
        <input type="password" name="password" placeholder="Contraseña" required />

        <button type="submit">Ingresar</button>

        @if(ViewBag.Error != null)
        {
            <p class="error">@ViewBag.Error</p>
        }
    </form>
</div>

<style>
    body{
        overflow: hidden;
    }
    /* Contenedor general */
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 70px); /* Altura menos la barra superior */
        padding-top: 70px; /* Barra home-bar */
        background: linear-gradient(135deg, #667eea, #764ba2);
    }

    /* Formulario */
    .login-form {
        background: rgba(255,255,255,0.95);
        padding: 40px 30px;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        width: 90%;
        max-width: 400px;
        text-align: center;
    }

    .login-form h2 {
        margin-bottom: 20px;
        color: #764ba2;
    }

    .login-form input {
        width: 100%;
        padding: 12px 15px;
        margin: 10px 0;
        border-radius: 10px;
        border: 1px solid #ccc;
        font-size: 1rem;
    }

    .login-form button {
        width: 100%;
        padding: 12px;
        border-radius: 50px;
        border: none;
        background: #667eea;
        color: white;
        font-weight: bold;
        cursor: pointer;
        font-size: 1rem;
        margin-top: 10px;
        transition: all 0.3s ease;
    }

    .login-form button:hover {
        background: #5a67d8;
    }

    .error {
        color: red;
        margin-top: 10px;
        font-size: 0.9rem;
    }

    @@media (max-width: 480px) {
        .login-form {
            padding: 30px 20px;
        }

        .login-form input,
        .login-form button {
            font-size: 0.9rem;
            padding: 10px;
        }
    }
</style>
