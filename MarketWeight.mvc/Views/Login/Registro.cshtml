@model VMRegistroUsuario
@{
    ViewData["Title"] = "Registro";
}
<div class="login-container">
    <form asp-action="Registro" method="post" class="login-form">
        <h2>Registro de Usuario</h2>

        <div class="form-group">
            <input asp-for="Nombre" placeholder="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input asp-for="Apellido" placeholder="Apellido" class="form-control" />
            <span asp-validation-for="Apellido" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input asp-for="Email" placeholder="Correo electrónico" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input asp-for="Password" placeholder="Contraseña" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input asp-for="ConfirmarPassword" placeholder="Confirmar contraseña" class="form-control" />
            <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Registrarse</button>

        @if(!ViewData.ModelState.IsValid)
        {
            <div class="text-danger mt-2">
                Corrige los errores en el formulario.
            </div>
        }
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/registro.css" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
