@{
    ViewData["Title"] = "Login";
}

<h2>Iniciar Sesión</h2>

<form asp-action="Login" asp-controller="Home" method="post">
    <div class="form-group">
        <label for="IdUsuario">Ingrese su ID de usuario</label>
        <input type="number" name="IdUsuario" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-success mt-3">Ingresar</button>
</form>
