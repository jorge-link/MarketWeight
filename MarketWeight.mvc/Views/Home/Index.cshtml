@{
    ViewData["Title"] = "MarketWeight";
}

<div class="home-container">
    <div class="home-card">
        <h1>Bienvenido a <span class="brand">MarketWeight</span></h1>
        <p>
            Presentamos MarketWeight, un programa de gestión de criptomonedas.
            Esta plataforma combina simplicidad, seguridad y accesibilidad,
            permitiendo a cualquier usuario, incluso sin experiencia financiera,
            explorar y operar con criptomonedas de manera práctica y confiable.
        </p>
    </div>
</div>

<style>
    .home-container {
        text-align: center;
        display: flex;
        justify-content: center;
        align-items: center;
        height: calc(100vh - 70px); /* altura menos la barra del layout */
        padding-top: 70px; /* espacio para la home-bar */
    }

    .home-card {
        background: rgba(255, 255, 255, 0.95);
        padding: 50px 40px;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        max-width: 500px;
        width: 100%;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .home-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.3);
    }

    .home-card h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
    }

    .home-card p {
        color: #555;
        margin-bottom: 30px;
        font-size: 1.1rem;
    }

    /* Responsivo */
    @@media (max-width: 768px) {
        .home-card {
            padding: 40px 30px;
        }
        .home-card h1 {
            font-size: 2rem;
        }
        .home-card p {
            font-size: 1rem;
        }
    }

    @@media (max-width: 480px) {
        .home-card {
            padding: 30px 20px;
        }
        .home-card h1 {
            font-size: 1.5rem;
        }
        .home-card p {
            font-size: 0.9rem;
        }
    }
</style>
