@{
    Layout = null;
    ViewData["Title"] = "MarketWeight";
}
@inject IHttpContextAccessor HttpContextAccessor

<div class="home-container">
    <div class="home-card">
        <h1>Bienvenido a <span class="brand">MarketWeight</span></h1>
        <p>Compra y vende criptomonedas de manera sencilla.</p>

        @if (HttpContextAccessor.HttpContext.Session.GetInt32("IdUsuario") == null)
{
    <a href="/Login/Index" class="btn">Iniciar Sesión</a>
    <a href="/Login/Registro" class="btn secondary">Registrarse</a>
}
else
{
    <a href="/Compra/ComprarMoneda" class="btn">Comprar Moneda</a>
    <form method="post" action="/Login/Logout">
        <button type="submit" class="btn secondary">Cerrar Sesión</button>
    </form>
}

    </div>
</div>

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #667eea, #764ba2);
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .home-container {
        text-align: center;
    }

    .home-card {
        background: rgba(255, 255, 255, 0.95);
        padding: 50px 40px;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.2);
        max-width: 500px;
        width: 100%;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .home-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.3);
    }

    .home-card h1 {
        font-size: 2.5rem;
        margin-bottom: 15px;
    }

    .brand {
        color: #764ba2;
        font-weight: bold;
    }

    .home-card p {
        color: #555;
        margin-bottom: 30px;
        font-size: 1.1rem;
    }

    .btn {
        display: inline-block;
        margin: 10px 15px;
        padding: 12px 30px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: bold;
        font-size: 1rem;
        color: #fff;
        background: #667eea;
        transition: all 0.3s ease;
    }

    .btn:hover {
        background: #5a67d8;
        transform: translateY(-2px);
    }

    .btn.secondary {
        background: #764ba2;
    }

    .btn.secondary:hover {
        background: #5a3e9e;
    }

    form {
        display: inline-block;
    }

    button.btn {
        border: none;
        cursor: pointer;
    }
</style>
